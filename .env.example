# Required — LLM credentials
LLM_API_KEY=
# Anthropic Messages API endpoint. Leave empty for the official API
# (https://api.anthropic.com/v1), or point at any compatible proxy/router.
LLM_BASE_URL=

# Required for Discord bot
DISCORD_TOKEN=

# Optional — enables semantic memory recall (Gemini embeddings).
# Without it, memory search falls back to full-text only.
GOOGLE_API_KEY=

# Optional — Google Calendar / Gmail / Drive / Tasks integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — enables GitHub Device Flow for private plugin repositories.
# Use a GitHub App client ID with Device Flow enabled and Contents read-only permission.
GITHUB_APP_CLIENT_ID=
# Optional — required only when the GitHub App issues expiring user tokens.
GITHUB_APP_CLIENT_SECRET=
# Optional — shows an install button so the owner can select accessible repositories.
GITHUB_APP_SLUG=
